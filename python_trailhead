<script>
(function(){
  async function init(){
    const boxes = Array.from(document.querySelectorAll('input.track'));
    let progress = {};
    try{
      const res = await window.storage.get('progress', false);
      if (res && res.value) progress = JSON.parse(res.value);
    }catch(e){ progress = {}; }

    boxes.forEach(cb => { if (progress[cb.id]) cb.checked = true; });

    async function save(){
      try{ await window.storage.set('progress', JSON.stringify(progress), false); }
      catch(e){ console.error('Could not save progress', e); }
    }

    function updateAll(){
      const total = boxes.length;
      let checked = 0;
      boxes.forEach(cb=>{
        if(cb.checked) checked++;
        const li = cb.closest('.day');
        if(li) li.classList.toggle('done', cb.checked);
      });
      const pct = total ? Math.round((checked/total)*100) : 0;

      const pctEl = document.getElementById('overall-pct');
      const countEl = document.getElementById('overall-count');
      const fillEl = document.getElementById('trail-fill');
      if(pctEl) pctEl.textContent = pct + '%';
      if(countEl) countEl.textContent = checked + ' / ' + total + ' days complete';
      if(fillEl) fillEl.style.width = pct + '%';

      document.querySelectorAll('.milestone').forEach(m=>{
        const th = parseInt(m.dataset.threshold, 10);
        m.classList.toggle('hit', pct >= th);
      });

      for(let m=1; m<=6; m++){
        const mBoxes = boxes.filter(cb => cb.dataset.month === String(m));
        const c = mBoxes.filter(cb => cb.checked).length;
        const mp = mBoxes.length ? Math.round((c/mBoxes.length)*100) : 0;
        const fEl = document.querySelector('[data-camp-fill="'+m+'"]');
        const pEl = document.querySelector('[data-camp-pct="'+m+'"]');
        const wpEl = document.querySelector('.waypoint[data-waypoint="'+m+'"]');
        if(fEl) fEl.style.width = mp + '%';
        if(pEl) pEl.textContent = mp + '% of this camp complete (' + c + '/' + mBoxes.length + ' days)';
        if(wpEl) wpEl.classList.toggle('complete', mp === 100);
      }

      document.querySelectorAll('.week').forEach(wk=>{
        const w = wk.dataset.week;
        const wBoxes = boxes.filter(cb => cb.dataset.week === w);
        const c = wBoxes.filter(cb => cb.checked).length;
        const label = wk.querySelector('[data-week-progress="'+w+'"]');
        if(label) label.textContent = c + '/' + wBoxes.length;
        wk.classList.toggle('complete', wBoxes.length > 0 && c === wBoxes.length);
      });
    }

    boxes.forEach(cb => cb.addEventListener('change', (e)=>{
      progress[e.target.id] = e.target.checked;
      save();
      updateAll();
    }));

    const resetBtn = document.getElementById('reset-progress');
    if(resetBtn){
      resetBtn.addEventListener('click', async ()=>{
        if(!window.confirm('Clear all checked days? This cannot be undone.')) return;
        progress = {};
        boxes.forEach(cb => cb.checked = false);
        await save();
        updateAll();
      });
    }

    updateAll();
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
